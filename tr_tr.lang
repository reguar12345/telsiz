package com.telsiz;

import com.telsiz.radio.RadioRegistry;
import com.telsiz.voice.RadioTransmissions;
import net.minecraftforge.common.MinecraftForge;
import net.minecraftforge.fml.common.Mod;
import net.minecraftforge.fml.common.event.FMLInitializationEvent;
import net.minecraftforge.fml.common.event.FMLPreInitializationEvent;
import net.minecraftforge.fml.common.event.FMLServerStoppingEvent;
import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;

/**
 * Telsiz - a walkie-talkie mod for Minecraft 1.12.2 built on top of the
 * Simple Voice Chat API (mod id "voicechat").
 *
 * All actual audio routing lives in {@link com.telsiz.voice.TelsizVoicechatPlugin},
 * which Simple Voice Chat discovers automatically via the {@code @ForgeVoicechatPlugin}
 * annotation (Forge 1.12.2 scans it through the ASMDataTable).
 */
@Mod(
        modid = Telsiz.MOD_ID,
        name = Telsiz.NAME,
        version = Telsiz.VERSION,
        acceptedMinecraftVersions = "[1.12.2]",
        dependencies = "required-after:voicechat",
        useMetadata = false
)
public class Telsiz {

    public static final String MOD_ID = "telsiz";
    public static final String NAME = "Telsiz";
    public static final String VERSION = "1.0.0";

    public static Logger LOGGER = LogManager.getLogger(NAME);

    @Mod.EventHandler
    public void preInit(FMLPreInitializationEvent event) {
        LOGGER = event.getModLog();
    }

    @Mod.EventHandler
    public void init(FMLInitializationEvent event) {
        // Server-side tick handler that keeps the radio state snapshot up to date
        // and cleans up finished transmissions.
        MinecraftForge.EVENT_BUS.register(new RadioRegistry());
    }

    @Mod.EventHandler
    public void serverStopping(FMLServerStoppingEvent event) {
        RadioRegistry.clear();
        RadioTransmissions.reset();
    }
}
